# Airbase Voice Module — Environment Variables
# Copy this to .env and fill in real values.
# All vars are prefixed VOICE_ to avoid collisions with the main Airbase app.

# ─── Twilio ───────────────────────────────────────────────────────────────────
VOICE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VOICE_TWILIO_AUTH_TOKEN=your_auth_token

VOICE_TWILIO_PHONE_NUMBER_GGB=+14155550001
VOICE_TWILIO_PHONE_NUMBER_RECAST=+17135550002
VOICE_TWILIO_PHONE_NUMBER_STEWARD=+14085550003  # Steward Home Services inbound line

# ─── STT / TTS ────────────────────────────────────────────────────────────────
VOICE_DEEPGRAM_API_KEY=your_deepgram_api_key

VOICE_CARTESIA_API_KEY=your_cartesia_api_key
VOICE_CARTESIA_VOICE_ID_GGB=your_voice_id_for_ggb
VOICE_CARTESIA_VOICE_ID_RECAST=your_voice_id_for_recast
VOICE_CARTESIA_VOICE_ID_STEWARD=your_voice_id_for_steward  # Jordan persona

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...  # Shared with main Airbase app

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ─── Voice server ─────────────────────────────────────────────────────────────
VOICE_BASE_URL=https://your-voice-server.railway.app  # Public URL; must be HTTPS for Twilio webhooks
PORT=3001

# ─── Escalation ───────────────────────────────────────────────────────────────
VOICE_DISPATCHER_NUMBER=+14085550099  # Steward dispatcher direct line — used in /voice/transfer TwiML
